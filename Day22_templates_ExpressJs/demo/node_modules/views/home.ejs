<!-- in this file we define the HTML structure for the home page which will be rendered by the Express application -->
 <h1> Welcome to Home Page <%=name %></h1>
 <!-- here <%=name %> is used to dynamic insert the value of the variable
    'name' passed from the server-side code -->
    <p> This is the home page of our website. </p>
    <p> Current year is : <%= year %></p>


<!-- Implemting for loops  -->
<ul>

  <% for(let i = 0; i < items.length; i++) { %>

    <li><%= items[i] %></li>

  <% } %>

</ul>

<!-- implemting if-else condition -->

<% if(user) { %>

  <p> Hello, <%= user %>! Welcome back!</p>

<% } else { %>

  <p> Hello, Guest! Please log in.</p>

<% } %>

<!-- implementing switch case -->

<% switch(role) { %>

  <% case 'admin': %>

    <p> You have administrative privileges. </p>

    <% break; %>

  <% case 'user': %>

    <p> You are logged in as a user. </p>

    <% break; %>

  <% default: %>

    <p> You are browsing as a guest. </p>

<% } %>




